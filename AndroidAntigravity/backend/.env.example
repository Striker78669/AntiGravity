# Use demo until you are ready to use your Gemini API key.
AI_PROVIDER=demo
# Copy this file to .env, then set these values to enable Gemini streaming.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=---
# GEMINI_MODEL=gemini-3.6-flash
# Google OAuth Web client ID. This is not the Gemini API key.
# GOOGLE_WEB_CLIENT_ID=---
# Allowed web origins, comma-separated. Android native clients do not need CORS.
ALLOWED_ORIGINS=http://localhost:3000
